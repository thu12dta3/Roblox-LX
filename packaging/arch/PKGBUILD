pkgname=roblox-lx
pkgver=0.1.0
pkgrel=1
pkgdesc='Private Darling compatibility diagnostics and launcher'
arch=('any')
url='https://github.com/thu12dta3/Roblox-LX'
license=('custom')
depends=('python>=3.10')
makedepends=()
source=()
sha256sums=()

package() {
  local repo_root
  repo_root="$(realpath "${startdir}/../..")"
  install -dm755 "${pkgdir}/usr/lib/roblox-lx/src" "${pkgdir}/usr/share/doc/roblox-lx/docs"
  cp -a "${repo_root}/src/robloxlx" "${pkgdir}/usr/lib/roblox-lx/src/"
  install -Dm644 "${repo_root}/LICENSE" "${pkgdir}/usr/share/licenses/roblox-lx/LICENSE"
  install -Dm644 "${repo_root}/README.md" "${pkgdir}/usr/share/doc/roblox-lx/README.md"
  install -Dm644 "${repo_root}/docs/INSTALLATION.md" "${pkgdir}/usr/share/doc/roblox-lx/docs/INSTALLATION.md"
  install -Dm644 "${repo_root}/docs/COMPATIBILITY.md" "${pkgdir}/usr/share/doc/roblox-lx/docs/COMPATIBILITY.md"
  install -Dm644 "${repo_root}/docs/API_BLOCKERS.md" "${pkgdir}/usr/share/doc/roblox-lx/docs/API_BLOCKERS.md"
  install -dm755 "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/robloxlx" <<'EOF'
#!/bin/sh
PYTHONPATH=/usr/lib/roblox-lx/src${PYTHONPATH:+:$PYTHONPATH} exec python -m robloxlx.cli "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/robloxlx"
}
