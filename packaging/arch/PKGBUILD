pkgname=roblox-lx
pkgver=0.2.0
pkgrel=1
pkgdesc='Linux-native host diagnostics and Vulkan compatibility research'
arch=('any')
url='https://github.com/thu12dta3/Roblox-LX'
license=('AGPL-3.0-only')
depends=('python>=3.10')
optdepends=('vulkan-tools: Vulkan diagnostics and host rendering smoke test'
            'nvidia-utils: NVIDIA GPU and driver reporting'
            'pciutils: fallback GPU identification')
makedepends=()
source=()
sha256sums=()

package() {
  local repo_root
  repo_root="$(realpath "${startdir}/../..")"
  install -dm755 "${pkgdir}/usr/lib/roblox-lx/src" "${pkgdir}/usr/share/doc/roblox-lx/docs"
  cp -a "${repo_root}/src/robloxlx" "${pkgdir}/usr/lib/roblox-lx/src/"
  install -Dm644 "${repo_root}/LICENSE" "${pkgdir}/usr/share/licenses/roblox-lx/LICENSE"
  install -Dm644 "${repo_root}/README.md" "${pkgdir}/usr/share/doc/roblox-lx/README.md"
  for doc in ARCHITECTURE COMPATIBILITY DEVELOPMENT ROADMAP SECURITY; do
    install -Dm644 "${repo_root}/docs/${doc}.md" "${pkgdir}/usr/share/doc/roblox-lx/docs/${doc}.md"
  done
  install -dm755 "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/robloxlx" <<'EOF'
#!/bin/sh
PYTHONPATH=/usr/lib/roblox-lx/src${PYTHONPATH:+:$PYTHONPATH} exec python -m robloxlx.cli "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/robloxlx"
}
