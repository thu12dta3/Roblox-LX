diff --git a/src/Metal/MTLBlitCommandEncoder.mm b/src/Metal/MTLBlitCommandEncoder.mm
new file mode 100644
index 0000000..eff9b91
--- /dev/null
+++ b/src/Metal/MTLBlitCommandEncoder.mm
@@ -0,0 +1,34 @@
+// SPDX-FileCopyrightText: 2026 Bannaman6655 Productions
+// SPDX-License-Identifier: MPL-2.0
+#import <Metal/MTLBlitCommandEncoderInternal.h>
+#import <Metal/MTLBufferInternal.h>
+#import <Metal/MTLDevice.h>
+@implementation MTLBlitCommandEncoderInternal {
+    std::shared_ptr<Indium::BlitCommandEncoder> _encoder;
+}
+@synthesize device = _device;
+@synthesize label = _label;
+- (instancetype)initWithEncoder:(std::shared_ptr<Indium::BlitCommandEncoder>)encoder
+                          device:(id<MTLDevice>)device {
+    self = [super init];
+    if (self) { _encoder = encoder; _device = [device retain]; }
+    return self;
+}
+- (void)dealloc { [_device release]; [_label release]; [super dealloc]; }
+- (void)endEncoding { _encoder->endEncoding(); }
+- (void)fillBuffer:(id<MTLBuffer>)buffer range:(NSRange)range value:(uint8_t)value {
+    if (!buffer || range.location > buffer.length || range.length > buffer.length - range.location ||
+        (range.location & 3) || (range.length & 3))
+        [NSException raise:NSInvalidArgumentException format:@"Invalid Metal fillBuffer range"];
+    _encoder->fillBuffer(((MTLBufferInternal *)buffer).buffer, {range.location, range.length}, value);
+}
+- (void)copyFromBuffer:(id<MTLBuffer>)source sourceOffset:(NSUInteger)sourceOffset
+             toBuffer:(id<MTLBuffer>)destination destinationOffset:(NSUInteger)destinationOffset
+                 size:(NSUInteger)size {
+    if (!source || !destination || sourceOffset > source.length || destinationOffset > destination.length ||
+        size > source.length - sourceOffset || size > destination.length - destinationOffset)
+        [NSException raise:NSInvalidArgumentException format:@"Invalid Metal buffer copy range"];
+    _encoder->copy(((MTLBufferInternal *)source).buffer, sourceOffset,
+                   ((MTLBufferInternal *)destination).buffer, destinationOffset, size);
+}
+@end
